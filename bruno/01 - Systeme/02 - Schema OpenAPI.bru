meta {
  name: Schema OpenAPI
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/openapi.json
  body: none
  auth: none
}

tests {
  test("Le schema decrit toutes les routes et le prefixe du proxy", function () {
    expect(res.getStatus()).to.equal(200);
    const schema = res.getBody();
    expect(schema.openapi).to.match(/^3\./);
    expect(schema.servers).to.deep.include({ url: "/api" });
    [
      "/health", "/players", "/players/{player_id}", "/species", "/biomes",
      "/encounter-types", "/encounters", "/encounters/{encounter_id}",
      "/skins/{minecraft_uuid}", "/skins/{minecraft_uuid}/texture"
    ].forEach(function (path) {
      expect(schema.paths).to.have.property(path);
    });
  });
}
