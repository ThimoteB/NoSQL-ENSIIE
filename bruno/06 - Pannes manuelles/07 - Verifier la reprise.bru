meta {
  name: Redis redemarre - verifier la rencontre unique
  type: http
  seq: 7
  tags: [
    manual
  ]
}

get {
  url: {{baseUrl}}/encounters?player_id={{failurePlayerId}}
  body: none
  auth: none
}

params:query {
  player_id: {{failurePlayerId}}
}

tests {
  test("Le scenario n'a cree qu'une seule rencontre", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.lengthOf(1);
    expect(res.getBody()[0].id).to.equal(bru.getEnvVar("failureEncounterId"));
    expect(res.getBody()[0].sync_status).to.equal("synced");
  });
}
