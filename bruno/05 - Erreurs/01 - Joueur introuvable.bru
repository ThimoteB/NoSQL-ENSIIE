meta {
  name: Joueur introuvable
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/players/{{missingPlayerId}}
  body: none
  auth: none
}

tests {
  test("Un UUID inexistant retourne 404", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().detail.code).to.equal("not_found");
  });
}
