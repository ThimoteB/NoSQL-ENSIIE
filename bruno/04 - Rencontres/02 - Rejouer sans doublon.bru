meta {
  name: Rejouer une rencontre sans doublon
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/encounters
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{encounterId}}
}

body:json {
  {
    "player_id": "{{playerId}}",
    "species_id": "{{speciesId}}",
    "animal_nickname": "Flamme",
    "location": {"biome_id": "{{biomeId}}", "label": "Pres du campement"},
    "encounter_type": "feeding",
    "description": "Le renard s'approche pour manger des baies."
  }
}

tests {
  test("La meme rencontre est retournee apres nettoyage du corps", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()).to.deep.equal(JSON.parse(bru.getVar("encounterSnapshot")));
  });
}
